def is_num(input_string): # Defining if user input was a number
    try:
        float(input_string)
        return True
    except ValueError:
        return False

def is_int(input_string): # Defining if user input was a integer
    try:
        int(input_string)
        return True
    except ValueError:
        return False

def is_even(input_string):
    try:
        int(input_string) % 2 == 0
        return True

        int(input_string) % 2 != 0
        return False
    
    except ValueError:
        return False

def is_morethan10(input_string): # Defining if user input is < 10
    try:
        int(input_string) > 10
        return True
    except ValueError:
        return False

def is_prime(input_string):  # Function to check for prime numbers
    n = int(input_string)
    if n < 2:
        return False
    for i in range(2, n):
        if n % i == 0:
            return False
    return True

